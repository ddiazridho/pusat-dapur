# Salin ke .env.local untuk `pnpm dev` (Supabase CLI lokal). Jangan commit nilai rahasia.
# Rujukan: docs/architecture/infra-operasional.md → Environment Variable.
# Nilai lokal Supabase didapat dari `pnpm db:local` / `pnpm exec supabase status`.

# --- Publik (boleh sampai ke browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server (rahasia) ---
SUPABASE_SECRET_KEY=
# Aplikasi: Supavisor transaction pooler :6543 + ?pgbouncer=true&connection_limit=1 (remote).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Migrasi/CI: session pooler/direct :5432 (remote). Lokal sama dengan DATABASE_URL.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Wajib hanya bila VERCEL_ENV=production. Kosongkan di lokal, CI, dan Preview
# (rate limit fail-open, cache laporan dilewati).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production: https://pusat-dapur.vercel.app. Lokal: http://localhost:3000 (atau PORT worktree).
# Preview tidak memakai APP_URL; origin diturunkan dari VERCEL_URL + VERCEL_BRANCH_URL.
APP_URL=http://localhost:3000

# Dipakai route cron (#22a, #24a). Vercel Cron mengirim Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# debug | info | warn | error
LOG_LEVEL=debug

# --- Hanya seed/CI (tidak dibaca aplikasi) ---
DEMO_EMAIL=juri@demo.example.com
DEMO_PASSWORD=

# --- Disediakan Vercel otomatis (jangan diisi manual) ---
# VERCEL_ENV=production|preview|development
# VERCEL_URL=
# VERCEL_BRANCH_URL=
