{
  "name": "pusat-dapur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.config.int.ts --dir tests/integration --passWithNoTests",
    "test:http": "vitest run --config vitest.config.int.ts --dir tests/http --passWithNoTests",
    "test:e2e": "playwright test",
    "db:local": "supabase start",
    "db:migrate:local": "node scripts/prisma-env.mjs local migrate dev",
    "db:deploy:dev": "node scripts/prisma-env.mjs dev migrate deploy"
  },
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.29",
    "eslint-plugin-boundaries": "^5.4.0",
    "prettier": "^3.6.0",
    "supabase": "^2.122.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "supabase"
    ]
  }
}
